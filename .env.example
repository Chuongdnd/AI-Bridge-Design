# Sao chép file này thành .env và điền API key của bạn
# KHÔNG commit file .env vào git (đã có trong .gitignore)

# Claude API Key — lấy tại: https://console.anthropic.com/
CLAUDE_API_KEY=

# (Tùy chọn) Model mặc định — có thể để trống để dùng claude-sonnet-4-6
# CLAUDE_DEFAULT_MODEL=claude-sonnet-4-6
